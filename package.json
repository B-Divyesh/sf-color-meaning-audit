{
  "name": "signal-check",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build",
    "build:site": "vite build --config site/vite.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run clean && npm run build:extension && npm run build:site && npm run package:extension",
    "typecheck": "wxt prepare && tsc --noEmit",
    "prepare:test": "npm run clean && npm run build:extension && npm run build:site && npm run package:extension && node scripts/verify-site-output.mjs",
    "test": "npm run typecheck && vitest run && npm run prepare:test && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "xvfb-run -a playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.1.4",
    "@types/node": "24.3.0",
    "archiver": "7.0.1",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4",
    "x11": "^4.1.0"
  }
}
